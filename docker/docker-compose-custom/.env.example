# ===== .env.example：复制为 .env 后填写（.env 已被 git 忽略，勿提交） =====
# 未列出的变量在 docker-compose.yml 内已有安全默认值。

# --- 镜像覆盖（可选） ---
# 默认 server 镜像从远端 docker.getcollate.io 拉取。若要在本机直接运行
# 本地构建的（含定制代码）server 镜像，取消注释并指向你的构建结果：
#   先构建：docker build -t openmetadata-server:custom -f Dockerfile .
# 再设置下面这行（同时会作用于 execute-migrate-all 和 openmetadata-server）：
# OPENMETADATA_SERVER_IMAGE=openmetadata-server:custom
#
# db / ingestion 默认也从 docker.getcollate.io 拉取。若该源在你的网络不可用
# （域名无法访问），可改走 Docker Hub 开源镜像（配合已配置的 registry-mirrors）：
# OPENMETADATA_DB_IMAGE=openmetadata/db:2.0.0
# OPENMETADATA_INGESTION_IMAGE=openmetadata/ingestion:2.0.0

# --- MySQL ---
MYSQL_ROOT_PASSWORD=<MySQL root 密码>

# --- Airflow（ingestion 服务） ---
AIRFLOW_PASSWORD=<Airflow 密码>

# --- OIDC / Casdoor 客户端凭据（必填） ---
AUTHENTICATION_CLIENT_ID=<Casdoor 应用 Client ID>
OIDC_CLIENT_ID=<Casdoor 应用 Client ID>
OIDC_CLIENT_SECRET=<Casdoor 应用 Client Secret>

# --- Casdoor 地址（部署环境相关；换域名/IP 只改这里） ---
AUTHENTICATION_AUTHORITY=https://casdoor.<域名>
OIDC_SERVER_URL=https://casdoor.<域名>
OIDC_DISCOVERY_URI=https://casdoor.<域名>/.well-known/openid-configuration
# 回调地址 = 浏览器实际访问 OpenMetadata 的地址 + /callback
AUTHENTICATION_CALLBACK_URL=http://<OM主机>:8585/callback
OIDC_CALLBACK=http://<OM主机>:8585/callback

# --- 管理员（完整邮箱，建议同时写入 AUTHORIZER_ADMIN_PRINCIPALS 的替代配置） ---
AUTHORIZER_ADMIN_EMAILS=["<管理员完整邮箱>"]

# --- 自助注册邮箱域名白名单 ---
# ["all"] = 放行所有域名；生产建议 ["<公司域名>"] 只放行公司域
AUTHORIZER_ALLOWED_REGISTRATION_DOMAIN=["<公司域名>"]

